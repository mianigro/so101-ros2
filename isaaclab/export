#!/usr/bin/env python3
"""Export one visual RSL-RL checkpoint and its real-robot interface manifest."""

from __future__ import annotations

import argparse
import importlib.metadata as metadata
import os
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
REPOSITORY_ROOT = PROJECT_ROOT.parent
sys.path.insert(0, str(PROJECT_ROOT / "source" / "so101_rl"))

from so101_rl.runtime import launch_isaac_sim_before_task_imports  # noqa: E402

launch_isaac_sim_before_task_imports(Path(__file__))

import gymnasium as gym  # noqa: E402
import numpy as np  # noqa: E402
import torch  # noqa: E402
from rsl_rl.runners import OnPolicyRunner  # noqa: E402

from isaaclab.app import add_launcher_args, launch_simulation  # noqa: E402
from isaaclab_rl.rsl_rl import (  # noqa: E402
    RslRlVecEnvWrapper,
    handle_deprecated_rsl_rl_cfg,
)
from isaaclab_tasks.utils import setup_preset_cli  # noqa: E402
from isaaclab_tasks.utils.hydra import hydra_task_config  # noqa: E402
from so101_rl.export_manifest import (  # noqa: E402
    build_policy_manifest,
    validate_deployable_contract,
    write_policy_manifest,
)
from so101_rl.visual_contract import SO101_JOINT_NAMES  # noqa: E402

import so101_rl.tasks  # noqa: E402,F401

sys.argv[1:] = [argument for argument in sys.argv[1:] if argument != "--headless"]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--task", required=True)
parser.add_argument("--checkpoint", required=True, type=Path)
parser.add_argument("--output-dir", required=True, type=Path)
add_launcher_args(parser)
args_cli, remaining_args = setup_preset_cli(parser, agent_library="rsl_rl")
sys.argv = [sys.argv[0], *remaining_args]


@hydra_task_config(args_cli.task, "rsl_rl_cfg_entry_point", play_mode=True)
def _export(env_cfg, agent_cfg) -> None:
    checkpoint = args_cli.checkpoint.expanduser().resolve()
    if not checkpoint.is_file():
        raise FileNotFoundError(f"checkpoint does not exist: {checkpoint}")
    output_dir = args_cli.output_dir.expanduser().resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    validate_deployable_contract(args_cli.task, env_cfg, agent_cfg)

    env_cfg.scene.num_envs = 1
    env_cfg.seed = agent_cfg.seed
    if args_cli.device is not None:
        env_cfg.sim.device = args_cli.device
        agent_cfg.device = args_cli.device

    with launch_simulation(env_cfg, args_cli):
        env = gym.make(args_cli.task, cfg=env_cfg, render_mode=None)
        wrapped = RslRlVecEnvWrapper(env, clip_actions=agent_cfg.clip_actions)
        agent_cfg = handle_deprecated_rsl_rl_cfg(
            agent_cfg, metadata.version("rsl-rl-lib")
        )
        runner = OnPolicyRunner(
            wrapped, agent_cfg.to_dict(), log_dir=None, device=agent_cfg.device
        )
        runner.load(str(checkpoint))
        runner.export_policy_to_jit(path=str(output_dir), filename="policy.pt")
        runner.export_policy_to_onnx(path=str(output_dir), filename="policy.onnx")

        observations = wrapped.get_observations()
        checkpoint_policy = runner.get_inference_policy(device=wrapped.unwrapped.device)
        with torch.inference_mode():
            expected = checkpoint_policy(observations)
            scripted = torch.jit.load(
                str(output_dir / "policy.pt"), map_location=wrapped.unwrapped.device
            )
            actual = scripted(
                observations["joint_state"],
                [
                    observations["wrist"],
                    observations["overhead_1"],
                    observations["overhead_2"],
                ],
            )
        max_error = float(torch.max(torch.abs(expected - actual)).item())
        if max_error > 1.0e-5:
            raise RuntimeError(
                f"TorchScript export parity failed: max action error {max_error:.3e}"
            )

        import onnx
        from onnx.reference import ReferenceEvaluator

        onnx_model = onnx.load(output_dir / "policy.onnx")
        onnx_names = [tensor.name for tensor in onnx_model.graph.input]
        expected_onnx_names = [
            "observation.state",
            "observation.images.wrist",
            "observation.images.overhead_1",
            "observation.images.overhead_2",
        ]
        if onnx_names != expected_onnx_names:
            raise RuntimeError(
                "ONNX input contract changed: "
                f"expected {expected_onnx_names}, got {onnx_names}"
            )
        onnx_tensors = [
            observations["joint_state"],
            observations["wrist"],
            observations["overhead_1"],
            observations["overhead_2"],
        ]
        onnx_actual = ReferenceEvaluator(onnx_model).run(
            None,
            {
                name: tensor.detach().cpu().numpy()
                for name, tensor in zip(onnx_names, onnx_tensors, strict=True)
            },
        )[0]
        onnx_error = float(
            np.max(np.abs(expected.detach().cpu().numpy() - onnx_actual))
        )
        if onnx_error > 1.0e-5:
            raise RuntimeError(
                f"ONNX export parity failed: max action error {onnx_error:.3e}"
            )

        robot = wrapped.unwrapped.scene["robot"]
        indices = [robot.joint_names.index(name) for name in SO101_JOINT_NAMES]
        limits = (
            robot.data.joint_pos_limits.torch[0, indices]
            .detach()
            .cpu()
            .tolist()
        )
        manifest = build_policy_manifest(
            args_cli.task,
            limits,
            output_dir / "policy.pt",
            output_dir / "policy.onnx",
        )
        write_policy_manifest(manifest, output_dir / "policy_manifest.json")
        wrapped.close()
        print(
            f"Exported deployable policy to {output_dir} "
            f"(TorchScript max error={max_error:.3e}, "
            f"ONNX max error={onnx_error:.3e})"
        )


def main() -> int:
    os.chdir(REPOSITORY_ROOT)
    _export()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
