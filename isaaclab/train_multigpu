#!/usr/bin/env python3
"""Launch repository-owned SO-101 training once per GPU."""

from __future__ import annotations

import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent

from isaaclab.cli.multigpu import MultiGpuLauncherCfg, run_multigpu_cli  # noqa: E402


LAUNCHER_CFG = MultiGpuLauncherCfg(
    prog="isaaclab/train_multigpu",
    description="Launch repository-owned SO-101 RSL-RL training on multiple GPUs.",
    worker_script=str(PROJECT_ROOT / "train"),
    rl_libraries=("rsl_rl",),
    supports_jax=False,
)


def main() -> int:
    return run_multigpu_cli(sys.argv[1:], LAUNCHER_CFG)


if __name__ == "__main__":
    raise SystemExit(main())
