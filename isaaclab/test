#!/usr/bin/env python3
"""Run the focused Isaac Lab tests in the configured source-built runtime."""

from __future__ import annotations

import os
import sys
import unittest
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
REPOSITORY_ROOT = PROJECT_ROOT.parent
sys.path.insert(0, str(PROJECT_ROOT))
sys.path.insert(0, str(PROJECT_ROOT / "source" / "so101_rl"))

from so101_rl.runtime import bootstrap_local_isaac_sim  # noqa: E402

bootstrap_local_isaac_sim(Path(__file__))


def main() -> int:
    """Discover and run the repository-owned Isaac Lab unit tests."""
    os.chdir(REPOSITORY_ROOT)
    suite = unittest.defaultTestLoader.discover(str(PROJECT_ROOT / "tests"))
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    return 0 if result.wasSuccessful() else 1


if __name__ == "__main__":
    raise SystemExit(main())
