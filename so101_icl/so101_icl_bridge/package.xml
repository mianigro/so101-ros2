<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_icl_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 shell for the ICL bridge node: mission dispatch packages to demo-conditioned rollouts.</description>
  <maintainer email="dmitri@manajev.com">Dmitri Manajev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- The node core (so101_icl.bridge_icl_node) is NOT pip-installed here:
       it carries the lerobot/peft stack and runs from the pixi lerobot env.
       Provide it via PYTHONPATH (see the pixi `icl_bridge` task) or add a
       <exec_depend> on an installed so101_icl package of your own. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
