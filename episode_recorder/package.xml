<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>episode_recorder</name>
  <version>0.1.0</version>
  <description>Minimalistic ROS2 episode recorder for imitation learning.
    Records strict canonical setups to rosbag2 episodes.</description>
  <maintainer email="dmitri@manajev.com">Dmitri Manajev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 core -->
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Bag recording -->
  <depend>yaml-cpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <!-- Camera and arm topics are resolved at runtime from the setup YAMLs in
       so101_bringup's share directory. That dependency is NOT declared here
       because so101_bringup already exec_depends on episode_recorder (it
       launches the recorder), which would create a cycle. In practice the
       recorder only runs inside so101_bringup sessions; standalone use must
       pass setups_dir explicitly. -->

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
