<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_ee_follower"
               params="mesh_dir:='package://so101_description/meshes' add_transmissions:='false' simulation_contact_pads:='false'">

    <link name="gripper_link">
      <xacro:inertial_block
        xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"
        mass="0.087"
        ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06"
        iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>

      <xacro:mesh_vc filename="${mesh_dir}/sts3215_03a_v1.stl"
        xyz="0.0077 0.0001 -0.0234" rpy="-1.5708 -5.19179e-17 -1.66533e-16" material="sts3215"/>

      <!-- Integrated 32x32 UVC wrist-camera mount; source STL units are millimetres. -->
      <visual>
        <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/wrist_cam_mount_32x32_uvc_so101.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="3d_printed"/>
      </visual>

      <!-- Keep the original wrist-roll collision mesh to avoid a dense camera-mount collider. -->
      <collision>
        <origin xyz="8.32667e-17 -0.000218214 0.000949706" rpy="-3.14159 -5.55112e-17 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/wrist_roll_follower_so101_v1.stl"/>
        </geometry>
      </collision>
    </link>

    <xacro:so101_gripper_frame />

    <link name="moving_jaw_so101_v1_link">
      <xacro:inertial_block
        xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"
        mass="0.012"
        ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09"
        iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>

      <xacro:mesh_vc filename="${mesh_dir}/moving_jaw_so101_v1.stl"
        xyz="-5.55112e-17 -5.55112e-17 0.0189" rpy="9.53145e-17 6.93889e-18 1.24077e-24" material="3d_printed"/>
    </link>

    <joint name="gripper" type="revolute">
      <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
      <parent link="gripper_link"/>
      <child link="moving_jaw_so101_v1_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
    </joint>

    <!--
      Simulation-only, collision-only contact pads.  Each pad is a distinct fixed
      rigid body so PhysX contact sensors can distinguish the two jaw faces.
      The 0.5 mm pad is centred 0.25 mm behind its contact face; the face itself
      protrudes 0.1 mm beyond the corresponding jaw mesh.
    -->
    <xacro:if value="${simulation_contact_pads}">
      <link name="fixed_jaw_contact_pad_link">
        <xacro:inertial_block
          xyz="0 0 0" rpy="0 0 0"
          mass="0.0001"
          ixx="7.908333333e-09" ixy="0" ixz="0"
          iyy="5.210416667e-09" iyz="0" izz="2.702083333e-09"/>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.0005 0.018 0.025"/>
          </geometry>
        </collision>
      </link>
      <joint name="fixed_jaw_contact_pad_joint" type="fixed">
        <origin xyz="-0.00805 -0.000218 -0.0925" rpy="0 0 0"/>
        <parent link="gripper_link"/>
        <child link="fixed_jaw_contact_pad_link"/>
      </joint>

      <link name="moving_jaw_contact_pad_link">
        <xacro:inertial_block
          xyz="0 0 0" rpy="0 0 0"
          mass="0.0001"
          ixx="7.908333333e-09" ixy="0" ixz="0"
          iyy="2.702083333e-09" iyz="0" izz="5.210416667e-09"/>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.0005 0.025 0.018"/>
          </geometry>
        </collision>
      </link>
      <joint name="moving_jaw_contact_pad_joint" type="fixed">
        <origin xyz="-0.01215 -0.0691 0.0190" rpy="0 0 0"/>
        <parent link="moving_jaw_so101_v1_link"/>
        <child link="moving_jaw_contact_pad_link"/>
      </joint>
    </xacro:if>

    <!-- follower-only motor6 transmission (optional) -->
    <xacro:if value="${add_transmissions}">
      <xacro:simple_transmission
        name="gripper_trans"
        joint="gripper"
        actuator="${actuator_prefix}motor6"/>
    </xacro:if>

    <xacro:so101_wrist_roll_joint
      add_transmission="${add_transmissions}"/>

  </xacro:macro>

</robot>
